{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "micirql-live",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "*-site.micirql.com/*",
      "zone_name": "micirql.com",
    },
    {
      "pattern": "forms.micirql.com/*",
      "zone_name": "micirql.com",
    },
  ],
  "ratelimits": [
    {
      "name": "MICIRQL_PUBLIC_FUNCTION_RATE_LIMITER",
      "namespace_id": "2026100601",
      "simple": {
        "limit": 8,
        "period": 60,
      },
    },
    {
      "name": "MICIRQL_NEWSLETTER_RATE_LIMITER",
      "namespace_id": "2026100602",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      "name": "MICIRQL_PREFLIGHT_RATE_LIMITER",
      "namespace_id": "2026100603",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "vars": {
    "MICIRQL_SUPABASE_URL": "https://buodqfijzaqmzbkghche.supabase.co",
    "MICIRQL_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_6HLaWSmycSxj3Dd2wKrcpg_Xw0ywbq7",
    "MICIRQL_PUBLIC_FUNCTIONS_ORIGIN": "https://forms.micirql.com",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
