{
  "name": "micirql-website-builder",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy:live": "cd apps/live && pnpm exec opennextjs-cloudflare build && pnpm exec opennextjs-cloudflare deploy -- --keep-vars",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "playwright test qa/top20-contracts.spec.ts qa/publish-export.spec.ts qa/live-publishing-runtime.spec.ts qa/auth-session.spec.ts qa/projects-auth-status.spec.ts --workers=4",
    "qa:top20": "playwright test qa/top20-contracts.spec.ts",
    "qa:dental:premium": "playwright test qa/dental-premium-render.spec.ts --workers=4",
    "qa:dental:premium:smoke": "playwright test qa/dental-premium-render.spec.ts --grep clinic-dental-precision",
    "qa:restaurant:routes": "playwright test qa/restaurant-candidate-route-visual.spec.ts --workers=4",
    "qa:builder:chrome": "playwright test -c qa/playwright.builder.config.ts",
    "qa:sections": "playwright test qa/sections.spec.ts",
    "qa:sections:full": "MI_QA_FULL=1 playwright test qa/sections.spec.ts",
    "qa:sections:evidence": "node qa/build-evidence.mjs",
    "verify:opennext-bundles": "node qa/verify-opennext-bundle.mjs apps/builder apps/live",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "pnpm": {
    "patchedDependencies": {
      "@opennextjs/cloudflare@1.20.7": "patches/@opennextjs__cloudflare@1.20.7.patch",
      "next@16.3.8": "patches/next@16.3.8.patch"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
