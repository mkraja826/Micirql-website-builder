{
  "name": "micirql-website-builder",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy:live": "cd apps/live && pnpm exec opennextjs-cloudflare build && pnpm exec opennextjs-cloudflare deploy -- --keep-vars",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "playwright test qa/top20-contracts.spec.ts qa/publish-export.spec.ts qa/live-publishing-runtime.spec.ts --workers=4",
    "qa:top20": "playwright test qa/top20-contracts.spec.ts",
    "qa:dental:premium": "playwright test qa/dental-premium-render.spec.ts --workers=4",
    "qa:dental:premium:smoke": "playwright test qa/dental-premium-render.spec.ts --grep clinic-dental-precision",
    "qa:sections": "playwright test qa/sections.spec.ts",
    "qa:sections:full": "MI_QA_FULL=1 playwright test qa/sections.spec.ts",
    "qa:sections:evidence": "node qa/build-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
