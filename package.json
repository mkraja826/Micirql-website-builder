{
  "name": "micirql-website-builder",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy:live": "cd apps/live && pnpm generate:runtime-css && pnpm exec opennextjs-cloudflare build && pnpm exec opennextjs-cloudflare deploy -- --keep-vars",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "qa:generation-benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "qa:dental-diversity": "playwright test --config=playwright.dental-diversity.config.ts",
    "qa:dental-visual": "playwright test --config=playwright.dental-visual.config.ts qa/dental-visual-comparison.spec.ts qa/dental-top20-visual-evidence.spec.ts qa/dental-top20-geometry-gate.spec.ts qa/dental-runtime-css-parity.spec.ts && node qa/certify-dental-top20-visual.mjs && playwright test --config=playwright.dental-visual.config.ts qa/dental-top20-premium-gate.spec.ts",
    "qa:dental-blueprint": "playwright test --config=playwright.dental-blueprint.config.ts",
    "qa:live-model-dental": "playwright test --config=playwright.live-model.config.ts",
    "qa:live-autonomous-composition": "playwright test --config=playwright.live-composition.config.ts",
    "qa:provider-retry": "playwright test --config=playwright.provider-retry.config.ts",
    "qa:sections": "playwright test qa/sections.spec.ts qa/functional-interactions.spec.ts",
    "qa:sections:core": "MI_QA_CORE=1 playwright test qa/sections.spec.ts qa/functional-interactions.spec.ts",
    "qa:sections:full": "MI_QA_FULL=1 playwright test qa/sections.spec.ts qa/functional-interactions.spec.ts",
    "qa:sections:regression:desktop-text": "MI_QA_CORE=1 playwright test qa/sections.spec.ts --grep \"(HERO-00[124]|TEAM-004).*1280px protocol smoke\"",
    "qa:sections:regression:shell": "MI_QA_FULL=1 playwright test qa/sections.spec.ts --grep \"CIN-(NAV|FOOT)-00[1-5].*protocol smoke\"",
    "qa:sections:evidence": "node qa/build-evidence.mjs",
    "qa:sections:certification": "node qa/build-certification-report.mjs",
    "qa:sections:visual-review": "node qa/build-visual-review-queue.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
