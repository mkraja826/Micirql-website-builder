{
  "name": "micirql-website-builder",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "qa:sections": "playwright test qa/sections.spec.ts",
    "qa:sections:full": "MI_QA_FULL=1 playwright test qa/sections.spec.ts",
    "qa:sections:evidence": "node qa/build-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "latest"
  }
}
